# Channel data is ephemeral — don't track message history
channels/*.jsonl

# Keep the directory itself
!channels/.gitkeep

# Boot scripts and PID files are auto-generated per hire, ephemeral
.boot-*.sh
.pid-*

# Python
__pycache__/
*.pyc
.pytest_cache/

# HIVE database
hive.db

# fleetd journal written by `fleetd record` run inside this repository; the real
# journal is a clone of the journal repository, never part of this one.
channels/journal/
